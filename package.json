{
  "name": "pulse-smart-watchlist",
  "version": "1.0.0",
  "private": true,
  "description": "A thoughtful smart market watchlist built for Groww CODE 2026",
  "scripts": {
    "build": "esbuild src/main.jsx --bundle --minify --sourcemap --outfile=public/app.js",
    "start": "node server.js",
    "dev": "esbuild src/main.jsx --bundle --sourcemap --outfile=public/app.js --watch",
    "test": "node --test",
    "package:submission": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-submission.ps1"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
